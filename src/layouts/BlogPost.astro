---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings?: { depth: number; slug: string; text: string }[] };

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;
const headings = Astro.props.headings || [];

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formattedDate = pubDate.toLocaleDateString('zh-TW', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const tocItems = headings.filter(h => h.depth === 2);
---

<html lang="zh-TW">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="article-layout">
				<article class="article-content">
					<header class="article-header">
						<h1 class="article-title">{title}</h1>
						<div class="article-meta">
							<time datetime={pubDate.toISOString()}>{formattedDate}</time>
							{tags.length > 0 && (
								<div class="article-tags">
									{tags.map((tag) => <span class="tag">{tag}</span>)}
								</div>
							)}
						</div>
					</header>

					{tocItems.length > 2 && (
						<nav class="toc">
							<div class="toc-title">內容</div>
							<ol class="toc-list">
								{tocItems.map((heading, index) => (
									<li>
										<a href={`#${heading.slug}`}>
											<span class="toc-num">{String(index + 1).padStart(2, '0')}</span>
											<span class="toc-text">{heading.text}</span>
										</a>
									</li>
								))}
							</ol>
						</nav>
					)}

					<div class="prose">
						<slot />
					</div>

					<nav class="article-nav">
						<a href="/blog">← 返回文章列表</a>
					</nav>
				</article>

				<aside class="sidebar">
					<div class="sidebar-section">
						<h4 class="sidebar-title">熱門文章</h4>
						<ul class="sidebar-list">
							{allPosts.slice(0, 5).map((post) => (
								<li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-layout {
		display: grid;
		grid-template-columns: 1fr 260px;
		gap: 3rem;
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	.article-content {
		min-width: 0;
	}

	.article-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border, #2d3748);
	}

	.article-title {
		font-size: 2rem;
		line-height: 1.3;
		margin-bottom: 1rem;
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.article-meta time {
		color: var(--text-muted, #64748b);
		font-size: 0.875rem;
	}

	.article-tags {
		display: flex;
		gap: 0.5rem;
	}

	/* TOC */
	.toc {
		margin-bottom: 2rem;
		padding: 1.25rem;
		background: var(--bg-secondary, #1a1a2e);
		border: 1px solid var(--border, #2d3748);
		border-radius: 6px;
	}

	.toc-title {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		color: var(--text-muted, #64748b);
		margin-bottom: 0.75rem;
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.toc-list li {
		margin-bottom: 0.4rem;
	}

	.toc-list a {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		color: var(--text-secondary, #94a3b8);
		text-decoration: none;
		font-size: 0.9rem;
		line-height: 1.5;
		padding: 0.25rem 0;
	}

	.toc-list a:hover {
		color: var(--accent, #d4a574);
	}

	.toc-num {
		color: var(--text-muted, #64748b);
		font-size: 0.8rem;
		font-weight: 500;
	}

	/* Prose */
	.prose {
		color: var(--text-secondary, #94a3b8);
	}

	.prose :global(h2) {
		font-size: 1.5rem;
		color: var(--text-primary, #f1f5f9);
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border, #2d3748);
		scroll-margin-top: 80px;
	}

	.prose :global(h3) {
		font-size: 1.25rem;
		color: var(--text-primary, #f1f5f9);
		margin-top: 2rem;
		scroll-margin-top: 80px;
	}

	.prose :global(p) {
		margin-bottom: 1.25rem;
		line-height: 1.8;
	}

	.prose :global(strong) {
		color: var(--text-primary, #f1f5f9);
	}

	.prose :global(a) {
		color: var(--link, #60a5fa);
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 1.25rem;
	}

	/* Article Nav */
	.article-nav {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border, #2d3748);
	}

	.article-nav a {
		color: var(--text-muted, #64748b);
		text-decoration: none;
	}

	.article-nav a:hover {
		color: var(--accent, #d4a574);
	}

	/* Sidebar */
	.sidebar {
		position: sticky;
		top: 2rem;
		height: fit-content;
	}

	.sidebar-section {
		margin-bottom: 2rem;
	}

	.sidebar-title {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted, #64748b);
		margin-bottom: 0.75rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border, #2d3748);
	}

	.sidebar-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.sidebar-list li {
		margin-bottom: 0.5rem;
	}

	.sidebar-list a {
		font-size: 0.85rem;
		color: var(--text-secondary, #94a3b8);
		text-decoration: none;
		line-height: 1.4;
	}

	.sidebar-list a:hover {
		color: var(--accent, #d4a574);
	}

	@media (max-width: 900px) {
		.article-layout {
			grid-template-columns: 1fr;
		}

		.sidebar {
			position: static;
			padding-top: 2rem;
			border-top: 1px solid var(--border, #2d3748);
		}
	}

	@media (max-width: 640px) {
		.article-title {
			font-size: 1.5rem;
		}
	}
</style>
