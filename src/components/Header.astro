---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<header class="header">
	<div class="header-top">
		<a href="/" class="logo">{SITE_TITLE}</a>
	</div>
	<nav class="nav">
		<a href="/" class="nav-link">首頁</a>
		<a href="/blog" class="nav-link">文章</a>
		<a href="/about" class="nav-link">關於</a>
	</nav>
	<button class="menu-toggle" id="menu-toggle" aria-label="開啟選單">
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<line x1="3" y1="6" x2="21" y2="6"></line>
			<line x1="3" y1="12" x2="21" y2="12"></line>
			<line x1="3" y1="18" x2="21" y2="18"></line>
		</svg>
	</button>
</header>

<!-- Mobile Drawer -->
<div class="mobile-drawer" id="mobile-drawer">
	<div class="drawer-overlay" id="drawer-overlay"></div>
	<div class="drawer-content">
		<button class="drawer-close" id="drawer-close" aria-label="關閉選單">✕</button>
		<nav class="drawer-nav">
			<a href="/">首頁</a>
			<a href="/blog">文章</a>
			<a href="/about">關於</a>
		</nav>
		<div class="drawer-section">
			<h4>熱門文章</h4>
			<ul>
				{allPosts.slice(0, 5).map((post) => (
					<li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
				))}
			</ul>
		</div>
	</div>
</div>

<script>
	const menuToggle = document.getElementById('menu-toggle');
	const drawer = document.getElementById('mobile-drawer');
	const drawerClose = document.getElementById('drawer-close');
	const overlay = document.getElementById('drawer-overlay');

	function openDrawer() {
		drawer?.classList.add('open');
		document.body.style.overflow = 'hidden';
	}
	function closeDrawer() {
		drawer?.classList.remove('open');
		document.body.style.overflow = '';
	}

	menuToggle?.addEventListener('click', openDrawer);
	drawerClose?.addEventListener('click', closeDrawer);
	overlay?.addEventListener('click', closeDrawer);
</script>

<style>
	.header {
		background: var(--bg-header, rgba(15, 15, 26, 0.95));
		border-bottom: 1px solid var(--border, #2d3748);
		padding: 1rem 1.5rem;
		text-align: center;
		backdrop-filter: blur(10px);
	}

	.header-top {
		margin-bottom: 0.75rem;
	}

	.logo {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-primary, #f1f5f9);
		text-decoration: none;
	}

	.logo:hover {
		color: var(--accent, #d4a574);
		text-decoration: none;
	}

	.nav {
		display: flex;
		justify-content: center;
		gap: 2rem;
	}

	.nav-link {
		color: var(--text-secondary, #94a3b8);
		text-decoration: none;
		font-size: 0.9rem;
		padding: 0.5rem 0;
		border-bottom: 2px solid transparent;
		transition: all 0.2s;
	}

	.nav-link:hover {
		color: var(--accent, #d4a574);
		border-bottom-color: var(--accent, #d4a574);
		text-decoration: none;
	}

	.menu-toggle {
		display: none;
		position: absolute;
		right: 1rem;
		top: 1rem;
		background: none;
		border: none;
		color: var(--text-primary, #f1f5f9);
		cursor: pointer;
		padding: 0.5rem;
	}

	/* Mobile Drawer */
	.mobile-drawer {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 200;
		visibility: hidden;
		pointer-events: none;
	}

	.mobile-drawer.open {
		visibility: visible;
		pointer-events: auto;
	}

	.drawer-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		opacity: 0;
		transition: opacity 0.3s;
	}

	.mobile-drawer.open .drawer-overlay {
		opacity: 1;
	}

	.drawer-content {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: 280px;
		background: var(--bg-secondary, #1a1a2e);
		padding: 1rem;
		transform: translateX(100%);
		transition: transform 0.3s;
		overflow-y: auto;
	}

	.mobile-drawer.open .drawer-content {
		transform: translateX(0);
	}

	.drawer-close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		background: none;
		border: none;
		font-size: 1.25rem;
		cursor: pointer;
		color: var(--text-secondary, #94a3b8);
	}

	.drawer-nav {
		margin-top: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border, #2d3748);
		margin-bottom: 1rem;
	}

	.drawer-nav a {
		padding: 0.75rem 0;
		color: var(--text-primary, #f1f5f9);
		font-weight: 500;
		text-decoration: none;
	}

	.drawer-section h4 {
		font-size: 0.75rem;
		text-transform: uppercase;
		color: var(--text-muted, #64748b);
		margin-bottom: 0.5rem;
	}

	.drawer-section ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.drawer-section li {
		margin-bottom: 0.5rem;
	}

	.drawer-section a {
		font-size: 0.875rem;
		color: var(--text-secondary, #94a3b8);
		text-decoration: none;
	}

	.drawer-section a:hover {
		color: var(--accent, #d4a574);
	}

	@media (max-width: 768px) {
		.header {
			position: relative;
		}

		.nav {
			display: none;
		}

		.menu-toggle {
			display: block;
		}
	}
</style>
