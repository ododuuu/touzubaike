---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-badge">新手友善・專業分析</div>
				<h1 class="hero-title">
					投資<span class="gradient-text">百科</span>
				</h1>
				<p class="hero-description">
					加密貨幣、股票、ETF、信用卡——投資理財一站式指南。
				</p>
				<div class="hero-cta">
					<a href="/blog" class="btn-primary">開始學習 →</a>
				</div>
			</section>

			<!-- Features -->
			<section class="features">
				<div class="feature-card">
					<h3>交易所評測</h3>
					<p>深度分析各大交易所的手續費、安全性與使用體驗</p>
				</div>
				<div class="feature-card">
					<h3>防詐騙指南</h3>
					<p>拆解常見詐騙手法，保護您的資產安全</p>
				</div>
				<div class="feature-card">
					<h3>新手教學</h3>
					<p>從開戶到出金，手把手帶您完成第一筆交易</p>
				</div>
			</section>

			<!-- Latest Posts -->
			<section class="latest-posts">
				<h2 class="section-title">最新文章</h2>
				<div class="posts-grid">
					{
						posts.map((post) => (
							<a href={`/blog/${post.id}/`} class="post-card">
								<div class="post-meta">
									{post.data.tags.slice(0, 2).map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-excerpt">{post.data.description}</p>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />

		<style>
			/* Hero */
			.hero {
				text-align: center;
				padding: 4rem 0 3rem;
			}

			.hero-badge {
				display: inline-block;
				padding: 0.5rem 1rem;
				background: rgba(124, 58, 237, 0.15);
				border: 1px solid rgba(124, 58, 237, 0.3);
				border-radius: 999px;
				color: #a78bfa;
				font-size: 0.875rem;
				font-weight: 500;
				margin-bottom: 1.5rem;
			}

			.hero-title {
				font-size: 3rem;
				font-weight: 800;
				margin-bottom: 1rem;
				line-height: 1.1;
			}

			.gradient-text {
				background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}

			.hero-description {
				font-size: 1.125rem;
				color: #94a3b8;
				max-width: 500px;
				margin: 0 auto 2rem;
			}

			.btn-primary {
				display: inline-block;
				padding: 0.875rem 2rem;
				background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%);
				color: white;
				border-radius: 12px;
				font-weight: 600;
				text-decoration: none;
				transition: all 0.2s ease;
			}

			.btn-primary:hover {
				transform: translateY(-2px);
				box-shadow: 0 10px 30px rgba(124, 58, 237, 0.4);
				color: white;
			}

			/* Features */
			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
				margin: 3rem 0;
			}

			.feature-card {
				background: rgba(26, 26, 46, 0.6);
				border: 1px solid rgba(148, 163, 184, 0.1);
				border-radius: 16px;
				padding: 1.5rem;
				text-align: center;
				transition: all 0.3s ease;
			}

			.feature-card:hover {
				border-color: rgba(124, 58, 237, 0.3);
				transform: translateY(-4px);
			}

			.feature-icon {
				font-size: 2rem;
				margin-bottom: 0.75rem;
			}

			.feature-card h3 {
				font-size: 1rem;
				margin-bottom: 0.5rem;
			}

			.feature-card p {
				font-size: 0.875rem;
				color: #64748b;
				margin: 0;
			}

			/* Latest Posts */
			.section-title {
				font-size: 1.5rem;
				margin-bottom: 1.5rem;
			}

			.posts-grid {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.post-card {
				display: block;
				background: rgba(26, 26, 46, 0.6);
				border: 1px solid rgba(148, 163, 184, 0.1);
				border-radius: 16px;
				padding: 1.5rem;
				text-decoration: none;
				transition: all 0.3s ease;
			}

			.post-card:hover {
				border-color: rgba(124, 58, 237, 0.5);
				transform: translateX(8px);
				background: rgba(26, 26, 46, 0.8);
			}

			.post-meta {
				display: flex;
				gap: 0.5rem;
				margin-bottom: 0.75rem;
			}

			.tag {
				padding: 0.25rem 0.75rem;
				background: rgba(124, 58, 237, 0.15);
				color: #a78bfa;
				border-radius: 999px;
				font-size: 0.75rem;
				font-weight: 500;
			}

			.post-title {
				font-size: 1.125rem;
				color: #f1f5f9;
				margin-bottom: 0.5rem;
			}

			.post-excerpt {
				font-size: 0.875rem;
				color: #64748b;
				margin: 0;
			}

			/* Responsive */
			@media (max-width: 768px) {
				.hero-title {
					font-size: 2rem;
				}

				.features {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
