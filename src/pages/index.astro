---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestPost = posts[0];
const otherPosts = posts.slice(1);
---

<html lang="zh-TW">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="home-layout">
				<div class="main-content">
					{/* 最新文章（大卡片） */}
					{latestPost && (
						<article class="featured-post">
							<h2 class="featured-title">
								<a href={`/blog/${latestPost.id}/`}>{latestPost.data.title}</a>
							</h2>
							<div class="featured-meta">
								<time datetime={latestPost.data.pubDate.toISOString()}>
									{latestPost.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
								</time>
								{latestPost.data.tags?.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
							<p class="featured-desc">{latestPost.data.description}</p>
							<a href={`/blog/${latestPost.id}/`} class="btn">閱讀全文 →</a>
						</article>
					)}

					{/* 更多文章（網格） */}
					{otherPosts.length > 0 && (
						<section class="more-posts">
							<h3 class="section-title">更多文章</h3>
							<div class="posts-grid">
								{otherPosts.map((post) => (
									<article class="post-card">
										<h4 class="post-title">
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</h4>
										<time class="post-date" datetime={post.data.pubDate.toISOString()}>
											{post.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
										</time>
									</article>
								))}
							</div>
						</section>
					)}
				</div>

				<aside class="sidebar">
					<div class="sidebar-section">
						<h4 class="sidebar-title">關於本站</h4>
						<p class="sidebar-text">投資百科提供加密貨幣、股票、ETF 等投資理財教學，幫助您做出明智的投資決策。</p>
					</div>
					<div class="sidebar-section">
						<h4 class="sidebar-title">熱門文章</h4>
						<ul class="sidebar-list">
							{posts.slice(0, 5).map((post) => (
								<li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-layout {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 3rem;
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	.main-content {
		min-width: 0;
	}

	/* Featured Post */
	.featured-post {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border, #2d3748);
		margin-bottom: 2rem;
	}

	.featured-title {
		font-size: 1.75rem;
		margin-bottom: 0.75rem;
	}

	.featured-title a {
		color: var(--text-primary, #f1f5f9);
		text-decoration: none;
	}

	.featured-title a:hover {
		color: var(--accent, #d4a574);
	}

	.featured-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 1rem;
	}

	.featured-meta time {
		color: var(--text-muted, #64748b);
		font-size: 0.875rem;
	}

	.featured-desc {
		color: var(--text-secondary, #94a3b8);
		margin-bottom: 1.25rem;
		line-height: 1.7;
	}

	/* More Posts Section */
	.section-title {
		font-size: 1rem;
		color: var(--text-muted, #64748b);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.post-card {
		padding: 1rem;
		background: var(--bg-card, #16213e);
		border: 1px solid var(--border, #2d3748);
		border-radius: 8px;
		transition: all 0.2s;
	}

	.post-card:hover {
		border-color: var(--accent, #d4a574);
	}

	.post-title {
		font-size: 1rem;
		font-weight: 600;
		margin: 0 0 0.5rem 0;
		line-height: 1.4;
	}

	.post-title a {
		color: var(--text-primary, #f1f5f9);
		text-decoration: none;
	}

	.post-title a:hover {
		color: var(--accent, #d4a574);
	}

	.post-date {
		font-size: 0.8rem;
		color: var(--text-muted, #64748b);
	}

	/* Sidebar */
	.sidebar {
		position: sticky;
		top: 2rem;
		height: fit-content;
	}

	.sidebar-section {
		margin-bottom: 2rem;
	}

	.sidebar-title {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted, #64748b);
		margin-bottom: 0.75rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border, #2d3748);
	}

	.sidebar-text {
		font-size: 0.875rem;
		color: var(--text-secondary, #94a3b8);
		line-height: 1.6;
		margin: 0;
	}

	.sidebar-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.sidebar-list li {
		margin-bottom: 0.5rem;
	}

	.sidebar-list a {
		font-size: 0.875rem;
		color: var(--text-secondary, #94a3b8);
		text-decoration: none;
		line-height: 1.4;
	}

	.sidebar-list a:hover {
		color: var(--accent, #d4a574);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.home-layout {
			grid-template-columns: 1fr;
		}

		.sidebar {
			position: static;
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
			padding-top: 2rem;
			border-top: 1px solid var(--border, #2d3748);
		}

		.sidebar-section {
			margin-bottom: 0;
		}
	}

	@media (max-width: 640px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}

		.sidebar {
			grid-template-columns: 1fr;
		}
	}
</style>
